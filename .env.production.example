# Production Environment Variable Template
# Copy to .env.production on production server / cloud dashboard

# Application URL & Host Settings
NEXT_PUBLIC_APP_URL=https://your-production-app.com
APP_URL=https://your-production-app.com
PORT=3000
NODE_ENV=production

# Supabase Production Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-production-service-role-key
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# AI Engine Integrations
OPENAI_API_KEY=sk-proj-your-production-openai-key
NEXT_PUBLIC_VAPI_PUBLIC_KEY=vapi-pub-your-production-key
VAPI_API_KEY=vapi-sec-your-production-key
VAPI_WEBHOOK_SECRET=whsec_your-production-webhook-secret

# External SaaS Tools
CALCOM_API_KEY=cal_live_your-production-key
RESEND_API_KEY=re_your-production-key

# Production Caching & Queue
REDIS_URL=redis://default:your-redis-password@your-redis-host:6379
REDIS_TOKEN=your-upstash-redis-token

# Security & JWT Authentication
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars
NEXTAUTH_SECRET=your-secure-random-nextauth-secret-at-least-32-chars
NEXTAUTH_URL=https://your-production-app.com

# Observability & Monitoring
OPENTELEMETRY_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
PROMETHEUS_METRICS_PORT=9090
LOG_LEVEL=info
