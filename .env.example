# Application Setup
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Public callback origin for third-party servers (Vapi tool-calls, Cal.com
# webhooks). MUST be publicly reachable — Vapi delivers tool-calls from its
# own cloud, so "localhost" resolves to Vapi's machine and every save_lead /
# book_appointment silently never arrives. Leave unset locally and the app
# disables voice tools (and logs why) rather than promising the visitor a
# booking it cannot deliver. For local end-to-end testing, run a tunnel
# (e.g. `ngrok http 3000`) and put the https URL here. In production set it
# to your deployed domain.
PUBLIC_BASE_URL=""

# Vapi PUBLIC key — used by the browser SDK to start the WebRTC call.
# Without this the widget stays in text-only demo mode and no audio plays.
NEXT_PUBLIC_VAPI_PUBLIC_KEY="your-vapi-public-key"

# Supabase Setup
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Direct Postgres connection — required ONLY by `npm run migrate`.
# DDL cannot be executed through the REST API, so this is a separate
# credential from the keys above.
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres"

# Vapi Integration
VAPI_API_KEY="your-vapi-api-key"
VAPI_WEBHOOK_SECRET="your-vapi-webhook-secret"

# Cal.com Integration
CALCOM_API_KEY="your-calcom-api-key"
CALCOM_EVENT_TYPE_ID="12345"
CALCOM_WEBHOOK_SECRET="your-calcom-webhook-secret"

# OpenAI (used for knowledge base embeddings)
OPENAI_API_KEY="your-openai-api-key"

# Redis (real caching + BullMQ queues — see scripts/worker.ts)
REDIS_URL="redis://localhost:6379"

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY="phc_your_key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Set to "true" ONLY where a background worker process is genuinely running
# (`npm run worker`, or the Kubernetes worker deployment). Leave unset on
# Vercel and other serverless hosts, which cannot run long-lived processes —
# enqueuing there would leave uploaded documents stuck at PENDING forever
# because nothing drains the queue. Unset means slower but always-completing
# synchronous indexing.
WORKER_ENABLED=""
