{
  "name": "ai-voice-business-card",
  "version": "1.0.0",
  "private": true,
  "redisMemoryServer": {
    "disablePostinstall": "1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "seed": "npm run seed:pagalava",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:db": "node --env-file-if-exists=.env.local scripts/verify-live-db.mjs",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "seed:pagalava": "tsx --env-file-if-exists=.env.local scripts/seed-pagalava.ts",
    "test:e2e": "playwright test",
    "seed:products": "node --env-file-if-exists=.env.local scripts/seed-products.mjs",
    "warm:qualification-audio": "tsx --env-file-if-exists=.env.local scripts/warm-qualification-audio.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@supabase/ssr": "^0.4.0",
    "@supabase/supabase-js": "^2.45.1",
    "@vapi-ai/web": "^2.6.1",
    "bullmq": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "framer-motion": "^11.3.21",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.424.0",
    "mammoth": "^1.12.0",
    "next": "^14.2.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/diff": "^7.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "redis-memory-server": "^0.17.0",
    "tailwindcss": "^3.4.7",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
